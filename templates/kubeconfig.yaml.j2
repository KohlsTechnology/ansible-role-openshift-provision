apiVersion: v1
kind: Config
clusters:
- name: cluster
  cluster:
    insecure-skip-tls-verify: true
    server: {{ openshift_connection_server | to_json }}
contexts:
- name: default
  context:
    cluster: cluster
    user: provisioner
current-context: default
users:
- name: provisioner
  user:
    token: {{ openshift_connection_token | to_json }}
